# Railway Build
FROM node:18-alpine AS build

# Install shadow for user management
RUN apk add --no-cache shadow

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Install client dependencies (including devDependencies for Vite)
COPY client/package*.json ./client/
RUN cd client && npm install

# Install server dependencies
COPY server/package*.json ./server/
RUN cd server && npm install --omit=dev

# Copy all source code
COPY . .

# Build frontend
RUN cd client && npm run build

# Production stage
FROM node:18-alpine

# Install shadow for user management
RUN apk add --no-cache shadow

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set production environment
ENV NODE_ENV=production

# Copy all source code for migrations
COPY --from=build /app/server ./server
COPY --from=build /app/client/dist ./client/dist
COPY --from=build /app/package.json ./package.json

# Install server dependencies
COPY server/package*.json ./server/
RUN cd server && npm install --omit=dev

# Set ownership
RUN chown -R appuser:appgroup /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-5000}/api/health || exit 1

USER appuser

# Don't hardcode port - Railway sets PORT env variable
# EXPOSE 5000  <- Removed, let Railway handle this

CMD ["node", "server/src/index.js"]

# MikroTik Config Builder - Production Environment Variables
# Copy this file to .env and update ALL values before going live.
# Generate secure keys: openssl rand -hex 64

# ==========================================
# Database Configuration
# ==========================================
# Generate a strong password: openssl rand -hex 32
DB_PASSWORD=your_secure_database_password_here
DATABASE_URL=postgres://postgres:your_secure_database_password_here@localhost:5432/mikrotik_billing

# ==========================================
# Security Keys (IMPORTANT: Change these!)
# ==========================================
# Generate JWT Secret: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_change_this_to_random_64_chars

# Generate Encryption Key: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_change_this_to_32_chars

# Initial production admin (required on first production boot if users table is empty)
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=change_this_initial_admin_password

# CORS origin is required in production
CORS_ORIGIN=https://your-domain.com

# Optional: enable connectivity polling service once stable
ENABLE_ROUTER_CONNECTIVITY=false
# Optional: enable monitoring API routes once stable
ENABLE_MONITORING_API=false

# ==========================================
# Email Configuration (required for notifications)
# ==========================================
# Choose one provider: smtp | sendgrid | mailgun | ses
EMAIL_PROVIDER=smtp

# IMPORTANT: Set this to your real sender address.
# Leaving it unset or using the placeholder will cause all emails to fail.
EMAIL_FROM=noreply@your-actual-domain.com

# --- SMTP (most common) ---
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# --- SendGrid (alternative) ---
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxx

# --- Mailgun (alternative) ---
# EMAIL_PROVIDER=mailgun
# MAILGUN_USER=postmaster@your-domain.mailgun.org
# MAILGUN_PASSWORD=your-mailgun-smtp-password

# --- AWS SES (alternative) ---
# EMAIL_PROVIDER=ses
# AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
# AWS_SES_USER=your-ses-smtp-user
# AWS_SES_PASSWORD=your-ses-smtp-password

# ==========================================
# Optional Integrations
# ==========================================
# Leave blank if not using

# Africa's Talking SMS
AT_API_KEY=
AT_USERNAME=
# IMPORTANT: Change this to your actual registered Sender ID
AT_SENDER_ID=MyISP

# M-Pesa Payment
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# !! WARNING: 174379 is the Safaricom SANDBOX test shortcode !!
# !! CHANGE THIS to your real production shortcode before going live !!
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# IMPORTANT: Change to 'live' only after setting your real shortcode above
MPESA_ENVIRONMENT=sandbox

# WhatsApp Notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==========================================
# Monitoring & Metrics
# ==========================================
# Set a strong secret to protect the Prometheus /metrics endpoint
METRICS_TOKEN=change_this_to_a_strong_random_token

# Sales dashboard monthly target (in your local currency)
MONTHLY_SALES_TARGET=100000

# ==========================================
# TR-069 Device Management (optional)
# ==========================================
# Set TR069_ACS_URL if you run a GenieACS ACS server
# TR069_ACS_URL=http://your-genieacs-host:7557
# TR069_PORT=7547

# ==========================================
# WireGuard CGNAT Tunnel Configuration
# ==========================================
# For MikroTik routers behind Carrier-Grade NAT (CGNAT), a WireGuard
# reverse tunnel allows the billing server to reach the router.
# The router initiates an outbound WireGuard connection (works through
# CGNAT), and the server communicates back through the tunnel.
#
# WireGuard interface name on the billing server
WG_INTERFACE=wg-billing
# Subnet prefix for tunnel IPs (server gets .1, routers get .2-.254)
WG_TUNNEL_SUBNET=10.200.0
# WireGuard listening port on the billing server
WG_TUNNEL_PORT=51820
# Public IP or hostname of the billing server (auto-detected if blank)
WG_SERVER_ENDPOINT=
# Directory for WireGuard config files
WG_CONFIG_DIR=/etc/wireguard
# Keepalive interval in seconds (critical for CGNAT traversal)
WG_PERSISTENT_KEEPALIVE=25

# ==========================================
# Docker Deployment
# ==========================================
# For VPS deployment, access your app at:
# http://your-server-ip

# For Dokploy, set CORS_ORIGIN to your domain:
# CORS_ORIGIN=https://your-domain.com
